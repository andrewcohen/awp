{
  "name": "tdeck",
  "private": true,
  "type": "module",
  "description": "A desktop surface for awp's agents, driving Claude through the Agent Client Protocol.",
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "daemon": "bun src/adapterd.ts",
    "shell": "electrobun dev",
    "shell:build": "electrobun build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@agentclientprotocol/claude-agent-acp": "0.70.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "electrobun": "^1.18.1",
    "typescript": "^5.9.0"
  }
}
