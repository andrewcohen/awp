{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* wails3 generate bindings mirrors each Go package's import path into
       frontend/bindings, so a binding's real location is
       bindings/github.com/andrewcohen/awp/gdeck/<service>. That is a directory
       name and not a URL, but it reads like one at every call site, and it is
       long enough that people copy it rather than write it. The alias keeps the
       generator's collision-proof layout on disk and off the page. Mirrored in
       vite.config.ts, which resolves imports for the actual build. */
    "paths": {
      "@bindings/*": ["./bindings/github.com/andrewcohen/awp/gdeck/*"]
    },
    "baseUrl": ".",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "bindings"],
}
