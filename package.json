{
  "name": "awp",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "react-doctor --no-supply-chain",
    "doctor:supply-chain": "react-doctor"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "react-doctor": "0.9.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
