{
  "name": "awp",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "react-doctor --no-supply-chain",
    "probe:zmx": "bun packages/server/src/probe/zmx-pty.ts",
    "probe:claims": "bun packages/server/src/probe/zmx-claims.ts",
    "doctor:supply-chain": "react-doctor",
    "amoeba": "bun run --filter amoeba dev:all",
    "daemon": "bun run --filter @awp-kit/server daemon",
    "probe:child-env": "bun packages/server/src/probe/child-env.ts",
    "probe:daemon": "bun packages/server/src/probe/daemon-roundtrip.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "react-doctor": "0.9.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "patchedDependencies": {
    "ghostty-web@0.4.0": "patches/ghostty-web@0.4.0.patch"
  }
}
