{
  "name": "amoeba",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "bun run scripts/build-electron.ts",
    "dev": "bun run build:electron && AMOEBA_DEV_SERVER=http://127.0.0.1:5273 electron .",
    "build": "vite build && bun run build:electron",
    "start": "bun run build && electron .",
    "dev:all": "vite --clearScreen false & bun run dev",
    "probe:shell": "bun run build && AMOEBA_SHOT_SCHEME=dark electron dist/electron/probe.js && AMOEBA_SHOT_SCHEME=light electron dist/electron/probe.js",
    "package": "bun run build && bun run scripts/package-app.ts"
  },
  "dependencies": {
    "@awp-kit/jobs": "workspace:*",
    "@awp-kit/pane": "workspace:*",
    "@awp-kit/protocol": "workspace:*",
    "@awp-kit/server": "workspace:*",
    "@base-ui/react": "1.7.0",
    "@effect/atom-react": "catalog:",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "1.3.6",
    "@pierre/trees": "1.0.0-beta.6",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-router": "1.170.32",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/postcss-plugin": "0.19.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "44.0.0",
    "vite": "8.2.2"
  }
}
