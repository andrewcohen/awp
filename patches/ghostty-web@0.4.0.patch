+  const now = awpNow();
+  term.awpDirtyAt = now;
+  term.awpHotAt = now;
+  if (term.awpTimeoutId !== undefined) {
+    clearTimeout(term.awpTimeoutId);
+    term.awpTimeoutId = undefined;
+    if (term.awpRun !== undefined && !term.isDisposed && term.isOpen) {
+      term.animationFrameId = requestAnimationFrame(term.awpRun);
+    }
+  }
+}
