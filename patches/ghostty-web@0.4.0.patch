+// --- awp: render when something changed, not every frame -------------------
+//
+// The render loop above called `renderer.render` unconditionally for as long
+// as the terminal was open — no dirty check anywhere in it. Measured over CDP
+// on a window with one idle terminal in it: ~100 animation frames a second,
+// each ending in a FULL-WINDOW paint (1692x1370, twice a frame, 1000 paints
+// in five seconds), which three backdrop-filter surfaces then re-blur over.
+// The renderer never reached idle. That is the whole of the window's cost
+// when nothing at all is happening.
+//
+// The loop itself is left running. A rAF that returns immediately is cheap;
+// what was expensive was the paint, and stopping the loop would mean owning
+// the question of when to start it again.
+//
+// ── a safety net rather than an exhaustive list of what dirties ───────────
+//
+// The honest way to do this is a dirty flag set by every mutation, and the
+// honest problem with it is that this is a minified bundle and a mutation
+// missed is a terminal that never repaints. So the flag is an optimisation
+// and the CLOCK is the guarantee: anything nobody thought of still reaches
+// the screen within IDLE_MS. Wrong here costs latency, not correctness.
+//
+//   output just arrived     render every frame for BUSY_MS after a write —
+//                           this is the case that has to be smooth
+//   the viewport moved      scrolling, which writes nothing
+//   the scrollbar is fading its opacity is animated by a timer, so it moves
+//                           with no write behind it
+//   otherwise               IDLE_MS, which is the cursor blink's cadence and
+//                           the floor for anything unaccounted for
+const AWP_BUSY_MS = 150;
+const AWP_IDLE_MS = 200;
+// How long a sleeping loop waits before looking again. Two frames, not the
+// 200ms heartbeat: this is the floor on how late anything the write path does
+// not announce — a scroll, a drag-selection, the cursor blink — can be drawn.
+// It costs a timer, and no rAF, so it commits no compositor frame.
+const AWP_COLD_MS = 32;
+
+const awpNow = () => (typeof performance === "object" ? performance.now() : Date.now());
+
+function awpShouldRender(term) {
+  const now = awpNow();
+  if (term.awpViewportY !== term.viewportY) {
+    term.awpViewportY = term.viewportY;
+    term.awpRenderedAt = now, term.awpHotAt = now;
+    return true;
+  }
+  // A scrollbar mid-fade animates on a timer with nothing written behind it.
+  if (term.scrollbarOpacity > 0) {
+    term.awpRenderedAt = now, term.awpHotAt = now;
+    return true;
+  }
+  // Selection is dragged with the pointer and writes nothing either. Guarded
+  // with `?.` because it is one more name in a minified bundle: if it is not
+  // there the clock below still covers it, a little less smoothly.
+  if (term.selectionManager?.isSelecting === true) {
+    term.awpRenderedAt = now, term.awpHotAt = now;
+    return true;
+  }
+  if (now - (term.awpDirtyAt ?? 0) < AWP_BUSY_MS) {
+    term.awpRenderedAt = now, term.awpHotAt = now;
+    return true;
+  }
+  if (now - (term.awpRenderedAt ?? 0) >= AWP_IDLE_MS) {
+    term.awpRenderedAt = now;
+    return true;
+  }
+  return false;
+}
+
+// --- awp: a frame loop that sleeps when there is nothing to draw -----------
+//
+// `awpShouldRender` gates the drawing, but the loop asked for a frame 120
+// times a second whatever the answer was — and a rAF request is a compositor
+// commit per frame whether or not a pixel changes. Measured against a
+// terminal with no canvas on screen and not one draw call in it: 500 commits
+// in five seconds.
+//
+// Hot is "the gate said yes for a reason", which is every branch of it but
+// the idle heartbeat — mark a new branch `awpHotAt` or it will sleep through
+// whatever that branch was added for. It stays hot for AWP_BUSY_MS after the
+// last one, so a fading scrollbar or a drag that pauses for a frame does not
+// drop to the timer and stutter back.
+//
+// Cold falls back to a timer at the heartbeat the gate already keeps, so
+// nothing rests on the dirty flag being perfect: a write nobody announced is
+// still drawn within AWP_IDLE_MS.
+function awpSchedule(term, run) {
+  if (term.awpTimeoutId !== undefined) {
+    clearTimeout(term.awpTimeoutId);
+    term.awpTimeoutId = undefined;
+  }
+  if (awpNow() - (term.awpHotAt ?? 0) < AWP_BUSY_MS) {
+    term.animationFrameId = requestAnimationFrame(run);
+    return;
+  }
+  // Kept apart from `animationFrameId`: `dispose` hands that one to
+  // `cancelAnimationFrame`, which does not cancel a timeout.
+  term.awpTimeoutId = setTimeout(() => {
+    term.awpTimeoutId = undefined;
+    run();
+  }, AWP_COLD_MS);
+}
+
+// --- awp: ink arriving wakes the loop ---------------------------------------
+//
+// Without this, output written while the loop is cold waits for the next cold
+// tick before it is even considered — latency bought straight out of the
+// thing the terminal is for. The write path knows exactly when ink arrived,
+// so it says so, and the loop goes back to rAF for as long as it keeps
+// arriving.
