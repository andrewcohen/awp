+
+// --- awp: block, shade and box-drawing glyphs as geometry -------------------
+//
+// Ghostty rasterises U+2500-U+259F itself rather than taking them from the
+// font, which is why a progress bar looks like a progress bar there and like
+// moire here. Three failures come from drawing them as text:
+//
+//   - shade characters are literal dot patterns in the font outline. Tiled at
+//     exact cell boundaries they read as flat grey; drawn at fractional origins
+//     each cell's dots fall out of phase with its neighbour's, which is the
+//     hatching seen across a progress bar;
+//   - box junctions do not meet, because a glyph's ink is sized to the font's
+//     idea of a cell rather than to this renderer's;
+//   - and anything wider than the measured cell is condensed to fit, which
+//     distorts the pattern further.
+//
+// Rectangles snapped to the cell fix all three: a full block is the cell, a half
+// block is half of it, a shade is a solid fill at a fraction of alpha, and a box
+// line runs from the cell edge to its centre so neighbours meet. Nothing is
+// measured, so nothing can be out of phase.
+//
+// Returns true when it has drawn; the caller falls back to fillText otherwise,
+// so an unhandled codepoint still renders.
+function awpDrawCellGlyph(ctx, text, x, y, w, h) {
+  if (text.length === 0 || text.length > 2) return false;
+  const cp = text.codePointAt(0);
+  if (cp === undefined || cp < 0x2500 || cp > 0x259f) return false;
+
+  // Whole pixels throughout. Half a pixel of offset is the difference between a
+  // seam and a join.
+  const x0 = Math.round(x), y0 = Math.round(y);
+  const x1 = Math.round(x + w), y1 = Math.round(y + h);
+  const cw = x1 - x0, ch = y1 - y0;
+  const halfW = Math.round(cw / 2), halfH = Math.round(ch / 2);
+
+  if (cp >= 0x2580) {
+    const fill = (fx, fy, fw, fh, alpha) => {
+      const prev = ctx.globalAlpha;
+      if (alpha !== undefined) ctx.globalAlpha = prev * alpha;
+      ctx.fillRect(fx, fy, fw, fh);
+      ctx.globalAlpha = prev;
+    };
+    switch (cp) {
+      case 0x2580: fill(x0, y0, cw, halfH); return true;
+      case 0x2584: fill(x0, y0 + halfH, cw, ch - halfH); return true;
+      case 0x2588: fill(x0, y0, cw, ch); return true;
+      case 0x258c: fill(x0, y0, halfW, ch); return true;
+      case 0x2590: fill(x0 + halfW, y0, cw - halfW, ch); return true;
+      case 0x2591: fill(x0, y0, cw, ch, 0.25); return true;
+      case 0x2592: fill(x0, y0, cw, ch, 0.5); return true;
+      case 0x2593: fill(x0, y0, cw, ch, 0.75); return true;
+      case 0x2594: fill(x0, y0, cw, Math.max(1, Math.round(ch / 8))); return true;
+      case 0x2595: { const t = Math.max(1, Math.round(cw / 8)); fill(x1 - t, y0, t, ch); return true; }
+      case 0x2596: fill(x0, y0 + halfH, halfW, ch - halfH); return true;
+      case 0x2597: fill(x0 + halfW, y0 + halfH, cw - halfW, ch - halfH); return true;
+      case 0x2598: fill(x0, y0, halfW, halfH); return true;
+      case 0x259d: fill(x0 + halfW, y0, cw - halfW, halfH); return true;
+      default: break;
+    }
+    if (cp >= 0x2589 && cp <= 0x258f) {
+      const eighths = 0x2590 - cp;
+      fill(x0, y0, Math.max(1, Math.round((cw * eighths) / 8)), ch);
+      return true;
+    }
+    if (cp >= 0x2581 && cp <= 0x2587) {
+      const eighths = cp - 0x2580;
+      const fh = Math.max(1, Math.round((ch * eighths) / 8));
+      fill(x0, y1 - fh, cw, fh);
+      return true;
+    }
+    return false;
+  }
+
+  // Box drawing, as arms from the centre. 0 none, 1 light, 2 heavy.
+  const arms = {
+    0x2500: [0, 1, 0, 1], 0x2501: [0, 2, 0, 2], 0x2502: [1, 0, 1, 0], 0x2503: [2, 0, 2, 0],
+    0x250c: [0, 1, 1, 0], 0x250d: [0, 2, 1, 0], 0x250e: [0, 1, 2, 0], 0x250f: [0, 2, 2, 0],
+    0x2510: [0, 0, 1, 1], 0x2511: [0, 0, 1, 2], 0x2512: [0, 0, 2, 1], 0x2513: [0, 0, 2, 2],
+    0x2514: [1, 1, 0, 0], 0x2515: [1, 2, 0, 0], 0x2516: [2, 1, 0, 0], 0x2517: [2, 2, 0, 0],
+    0x2518: [1, 0, 0, 1], 0x2519: [1, 0, 0, 2], 0x251a: [2, 0, 0, 1], 0x251b: [2, 0, 0, 2],
+    0x251c: [1, 1, 1, 0], 0x2523: [2, 2, 2, 0], 0x2524: [1, 0, 1, 1], 0x252b: [2, 0, 2, 2],
+    0x252c: [0, 1, 1, 1], 0x2533: [0, 2, 2, 2], 0x2534: [1, 1, 0, 1], 0x253b: [2, 2, 0, 2],
+    0x253c: [1, 1, 1, 1], 0x254b: [2, 2, 2, 2],
+    // Rounded corners drawn square: an arc at this size is a pixel or two of
+    // difference and needs its own path, where the join is what matters.
+    0x256d: [0, 1, 1, 0], 0x256e: [0, 0, 1, 1], 0x256f: [1, 0, 0, 1], 0x2570: [1, 1, 0, 0],
+    0x2574: [0, 0, 0, 1], 0x2575: [1, 0, 0, 0], 0x2576: [0, 1, 0, 0], 0x2577: [0, 0, 1, 0],
+    0x2578: [0, 0, 0, 2], 0x2579: [2, 0, 0, 0], 0x257a: [0, 2, 0, 0], 0x257b: [0, 0, 2, 0],
+  }[cp];
+  if (!arms) return false;
+
+  const light = Math.max(1, Math.round(ch / 14));
+  const heavy = light * 2;
+  const midX = x0 + halfW, midY = y0 + halfH;
+  const gauge = (weight) => (weight === 2 ? heavy : light);
+  const [n, e, s, w2] = arms;
+  // Each arm runs from the cell edge through the centre, so two adjacent cells
+  // meet across the boundary with no gap.
+  if (n) { const t = gauge(n); ctx.fillRect(midX - Math.round(t / 2), y0, t, midY - y0 + Math.round(t / 2)); }
+  if (s) { const t = gauge(s); ctx.fillRect(midX - Math.round(t / 2), midY - Math.round(t / 2), t, y1 - midY + Math.round(t / 2)); }
+  if (w2) { const t = gauge(w2); ctx.fillRect(x0, midY - Math.round(t / 2), midX - x0 + Math.round(t / 2), t); }
+  if (e) { const t = gauge(e); ctx.fillRect(midX - Math.round(t / 2), midY - Math.round(t / 2), x1 - midX + Math.round(t / 2), t); }
+  return true;
+}
